source "https://rubygems.org"

gem "activesupport", "~> 6.0"
gem "rexml", ">= 3.2.4"

gem 'jruby-openssl', :platforms => :jruby

group :test, :remote_test do
  # gateway-specific dependencies, keeping these gems out of the gemspec
  gem 'braintree', '~> 2.78.0'
  gem "psych", "< 4"
end

gemspec path: "../"
